{
  "name": "uwr",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb",
    "spacetime:publish": "spacetime publish uwr --server local",
    "spacetime:publishprod": "spacetime publish uwr --server maincloud"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "spacetimedb": "^2.10.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  }
}
